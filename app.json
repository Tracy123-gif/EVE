{
  "expo": {
    "name": "EVE",
    "slug": "EVE",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "eve",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.eve.app",
      "infoPlist": {
        "NSCameraUsageDescription": "EVE uses your camera so you can add photos to your memory pages.",
        "NSPhotoLibraryUsageDescription": "EVE needs access to your photos so you can add them to your memory pages.",
        "NSMicrophoneUsageDescription": "EVE uses your microphone to record short voice notes on your memories."
      }
    },
    "android": {
      "package": "com.eve.app",
      "adaptiveIcon": {
        "backgroundColor": "#FAF3E6",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "EVE needs access to your photos so you can add them to your memory pages."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "EVE uses your camera so you can add photos to your memory pages.",
          "microphonePermission": "EVE uses your microphone to record short voice notes on your memories."
        }
      ],
      [
        "expo-av",
        {
          "microphonePermission": "EVE uses your microphone to record short voice notes on your memories."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#4A3140"
        }
      ],
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "c5a54c3e-9338-41db-8c2a-085949473312"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/c5a54c3e-9338-41db-8c2a-085949473312"
    }
  }
}
